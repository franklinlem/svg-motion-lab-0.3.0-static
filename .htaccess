Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "strict-origin-when-cross-origin"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-nnhJPWAfWle2YL3evPuUa5a6CmbXx+SVhG+via/EHmc=' 'sha256-qROKPO/uJbqOQeX6beiLKkQNT/yNxSI/Oaz7cGMcqZ0=' 'sha256-BDADRVewdCu96+g3c+wrGxO8Q4ZBv0MN4o51nWCsuj4=' 'sha256-1YqeGYSi90MqXzD/JK4KnEo0vi21dI/jogK3MXbIKX4=' 'sha256-LDqaB4o+ICfrEhJJftM0oSJV3wVtyO83H6sGJxcj8og=' 'sha256-pWnMTX5qLltJ4l3hSXP/Yl2e1cmIlUlkmm78KfH+shQ=' 'sha256-0IwwBeaGSHW7Jip9y83ikkwZgWbtDohstJtRf28pauQ=' 'sha256-HhvfH+pzI4Vxn6o5uGeXHLSBuY5Sx8cG2/gaUCwh/GM=' 'sha256-3gA/0XQY2zpS6oNT3fk245iTAnmXqfCRXyJ/C8JQIX0=' 'sha256-NxyzgLXCMtUiLSH6UZJ1Jg/eNPqB7bkXajXCQJItxeQ=' 'sha256-lvrsjn/WaxcuR/bVyvEjFOvlxE+i/2Kllv5qNuIXR0Q=' 'sha256-Tr1bxTto3rlA+5K3G4Q+/8JEhopvQI92lsLbieZllbA=' 'sha256-K/Nxl11mcIPoe9Is8ChDh2xR/+M4j79gBAc+OT+vdcE='; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; worker-src 'self'; manifest-src 'self'"
 <FilesMatch "\.(html|js|webmanifest)$">
  Header set Cache-Control "no-cache"
 </FilesMatch>
</IfModule>
